// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  username  String?  @unique
  email     String?  @unique
  emailVerified DateTime?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  accounts  Account[]
  sessions  Session[]
  logs      GameLog[]
  lists     CustomList[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id              String  @id @default(cuid())
  sessionToken    String  @unique
  userId          String
  expires         DateTime
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier    String
  token         String @unique
  expires       DateTime

  @@unique([identifier, token])
}

model GameLog {
  id         String   @id @default(cuid())
  rating     Float?   // e.g., 4.5 out of 5
  review     String?  @db.Text
  status     String   @default("PLAYED") // PLAYED, PLAYING, BACKLOG, ABANDONED
  playedOn   DateTime @default(now())
  
  // Game ID from external API (like IGDB or RAWG)
  externalGameId  Int  
  gameTitle       String    // cached title for easy display
  coverUrl        String?   // Cached cover image coverUrl

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomList {
  id          String   @id @default(cuid())
  title       String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items       ListItem[]
}

model ListItem {
  id             String     @id @default(cuid())
  listId         String
  list           CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  externalGameId Int
}