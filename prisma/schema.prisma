// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(cuid())
  name            String?
  username        String?  @unique
  email           String?  @unique
  emailVerified   DateTime?
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  steamId         String? @unique // store the user's linked Steam ID
  
  accounts        Account[]
  sessions        Session[]
  gameLogs        GameLog[]
  lists           CustomList[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id              String  @id @default(cuid())
  sessionToken    String  @unique
  userId          String
  expires         DateTime
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier    String
  token         String @unique
  expires       DateTime

  @@unique([identifier, token])
}

model GameLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  steamAppId      Int?                        // Steam AppID (from Steam API)
  igdbId          Int?                        // IGDB Game Id (from search or resolved during sync)

  gameTitle       String                      // cached title for easy display
  coverUrl        String?                     // Cached cover image coverUrl
  playtimeHours   Float?    @default(0)       // Total hours synced from Steam
  isOwned         Boolean   @default(false)
  rating          Float?                      // e.g., 4.5 out of 5
  review          String?   @db.Text
  status          String                      // PLAYED, PLAYING, BACKLOG, etc.
  playedOn        DateTime  @default(now())
  platforms       String[]                    // Multi-select platform tags stores as string array

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, steamAppId])
  @@unique([userId, igdbId])
}

model CustomList {
  id          String   @id @default(cuid())
  title       String
  description String?
  isPrivate   Boolean
  createdAt   DateTime  @default(now()) 
  updatedAt   DateTime  @updatedAt 
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  items       CustomListItem[]
}

model CustomListItem {
  id               String     @id @default(cuid())
  customListId     String
  customList       CustomList @relation(fields: [customListId], references: [id], onDelete: Cascade)

  gameTitle     String
  coverUrl      String?
  igdbId        Int?
  steamAppId    Int?
  position      Int         @default(0)
  addedAt       DateTime    @default(now())
}